# Maintainer: Marcus Puchalla <marcus.puchalla@googlemail.com>
pkgname=trot-bin
_pkgname=trot
pkgver=0.1.0
pkgrel=1
pkgdesc="Underdesk treadmill tracker: CLI + daemon (Bluetooth/BLE) — prebuilt binary"
arch=('x86_64')
url="https://github.com/marcuspuchalla/trot"
license=('GPL-3.0-or-later')
depends=('dbus' 'gcc-libs')
provides=('trot')
conflicts=('trot')
source=("$_pkgname-$pkgver.tar.xz::https://github.com/marcuspuchalla/trot/releases/download/v$pkgver/trot-x86_64-unknown-linux-gnu.tar.xz")
sha256sums=('SKIP')  # run `updpkgsums`; cross-check against the .sha256 on the release

package() {
    # dist archives unpack into a dir named after the archive stem.
    cd "trot-x86_64-unknown-linux-gnu"
    install -Dm0755 "trot" "$pkgdir/usr/bin/trot"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
    install -Dm0644 LICENSE  "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
